# Kopieer naar .env en vul in. Zet .env nooit in Git.
SITE_URL=https://aardrijkskunde.example.nl

DB_NAME=aklokaal
DB_USER=aklokaal
# Lange, willekeurige wachtwoorden (bijvoorbeeld: openssl rand -base64 32)
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Poort op de thuisserver (alleen lokaal; publiek via Cloudflare Tunnel)
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Interactieve toepassingen (apps/) op een eigen subdomein, bv. https://apps.example.nl
APPS_PORT=8081

# Optioneel: PowerPoint → PDF (start met --profile conversie)
CONVERTER_URL=http://converter:3000

# Optioneel: Cloudflare Tunnel-token (Zero Trust → Networks → Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# Back-ups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3
